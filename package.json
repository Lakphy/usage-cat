{
  "name": "usage-cat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc -b --pretty false",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run && vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types src/worker/env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply usage-cat --local",
    "db:migrate:remote": "wrangler d1 migrations apply usage-cat --remote"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hono/zod-validator": "^0.7.6",
    "@hookform/resolvers": "^5.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.87.4",
    "@tanstack/react-router": "^1.131.36",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "hono": "^4.9.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@cloudflare/puppeteer": "1.4.0",
    "@cloudflare/vite-plugin": "^1.13.14",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/router-plugin": "^1.131.36",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^4.1.11",
    "wrangler": "^4.35.0"
  }
}
